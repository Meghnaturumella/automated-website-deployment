# .gitignore - Tells Git which files/folders to ignore (not track).

# ----- OS junk files -----
Thumbs.db
Desktop.ini
.DS_Store

# ----- Editor / IDE settings -----
.vscode/
.idea/
*.swp
*.swo

# ----- Docker -----
# Don't track any accidentally saved Docker data.
docker-compose.override.yml

# ----- Logs -----
*.log

# ----- Node / npm (in case added later) -----
node_modules/
